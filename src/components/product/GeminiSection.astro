---
import Screenshot from "@/components/media/Screenshot.astro";
import Note from "@/components/ui/Note.astro";
import { AI_SCENARIOS } from "@/data/tools";
import { shot } from "@/data/shots";

const lead = shot("v4-ai-login");
---

<div class="space-y-10">
  <div class="grid gap-6 lg:grid-cols-[1fr_0.85fr] lg:items-start">
    <div>
      <p class="text-[14.5px] leading-relaxed text-ink-2">
        V4 起集成了 <strong class="font-medium">Gemini CLI</strong>，下面五条命令
        都是作者输入的原话，截图也是当时的实录。首次使用需要先登录 Google 账号。
      </p>
      <p class="mt-3 font-mono text-[12px] text-muted">
        启动方式：在终端执行 <code class="rounded border border-line bg-breeze-50 px-1.5 py-0.5 text-[12px]">gemini-cli</code>
      </p>
    </div>
    <Screenshot shot={lead} sizes="(max-width: 1024px) 92vw, 460px" />
  </div>

  <ol class="space-y-8">
    {
      AI_SCENARIOS.map((scenario, i) => (
        <li class="glass-flat overflow-hidden">
          <div class="border-b border-line bg-surface-tint/60 px-5 py-4 sm:px-6">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[11px] text-breeze-600">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="font-display text-[17px] font-semibold text-ink">
                {scenario.title}
              </h3>
            </div>
            <p class="mt-2.5 rounded-control border border-line bg-[#0b1524] px-3.5 py-2.5 font-mono text-[12.5px] leading-relaxed text-[#c9dbef]">
              <span class="text-[#5b7391]">$ </span>
              {scenario.prompt}
            </p>
            <p class="mt-2.5 text-[13px] leading-relaxed text-muted">
              {scenario.result}
            </p>
          </div>

          <div class="grid gap-4 p-4 sm:grid-cols-2 sm:p-5 lg:grid-cols-3">
            {scenario.shots.map((slug) => (
              <Screenshot
                shot={shot(slug)}
                sizes="(max-width: 640px) 92vw, (max-width: 1024px) 44vw, 300px"
                widths={[400, 800, 1200]}
              />
            ))}
          </div>
        </li>
      ))
    }
  </ol>

  <Note variant="danger" title="仅限获得书面授权的目标">
    <p>
      「自动化信息收集与漏洞扫描」演示里出现的目标地址是作者自己的实验网络。
      把 AI 生成或执行的扫描命令用在任何未授权的目标上都是违法的。
    </p>
  </Note>
</div>
