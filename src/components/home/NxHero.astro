---
import { Picture } from "astro:assets";
import { HERO_SHOT as bg } from "@/data/home";
import { CURRENT_VERSION } from "@/data/versions";
import { PRODUCTS } from "@/data/products";
import { getReleases } from "@/lib/github";


const latest = getReleases("kde")[0];
---

<!-- 首屏：全幅桌面截图 + 超大标题（参照 Nitrux 的做法：图片出血、无边框） -->
<section class="relative flex min-h-[88vh] flex-col justify-end overflow-hidden">
  <!-- 背景图 -->
  <div class="absolute inset-0">
    <Picture
      fallbackFormat="webp"
      src={bg.image}
      formats={["avif", "webp"]}
      widths={[900, 1440, 1900]}
      sizes="100vw"
      alt={bg.alt}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full scale-105 object-cover object-center"
      style="filter: blur(2px)"
    />
    <!-- 压暗：保证文字可读，同时保留图片的层次 -->
    <div
      class="absolute inset-0 bg-[linear-gradient(90deg,rgba(8,11,16,.9)_0%,rgba(8,11,16,.62)_45%,rgba(8,11,16,.26)_100%)]"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 bg-[linear-gradient(0deg,rgba(8,11,16,.92)_0%,transparent_38%)]"
      aria-hidden="true"
    ></div>
  </div>

  <div class="shell relative pb-12 pt-28 sm:pb-16">
    <p class="font-mono text-[11.5px] uppercase tracking-[0.22em] text-white/55">
      Kali Custom Lab — {CURRENT_VERSION.baseSystem}
    </p>

    <h1
      class="mt-4 max-w-[22ch] text-[clamp(36px,6.2vw,88px)] font-semibold leading-[0.98] tracking-[-0.02em] text-white"
    >
      好看。<span class="text-white/45">不卡。</span>好用。<br />两套方案。
    </h1>

    <p class="mt-6 max-w-[52ch] text-[15px] leading-relaxed text-white/70">
      基于 Kali Linux {CURRENT_VERSION.baseSystem.replace("Kali Linux ", "")} 的桌面定制。
      KDE Plasma 6.7 与 i3wm 两条线，自带 fcitx5 输入法、zsh 终端与整套桌面美化。
    </p>

    <p class="mt-2 font-mono text-[12px] text-white/45">
      内核 {CURRENT_VERSION.kernel} · Plasma 6.7.4 / Qt 6.11.2 · 固件 BIOS
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href="/download/" class="btn btn--primary btn--lg">
        下载 {PRODUCTS.kde.versionLabel}
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 5v14M6 13l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <a
        href="#showcase"
        class="btn btn--lg border border-white/25 bg-white/8 text-white backdrop-blur-sm hover:bg-white/15"
      >
        看实际效果
      </a>
    </div>

    <!-- 版本信息条：像 Nitrux 那样把 release 信息直接放在首屏 -->
    <div
      class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-white/12 pt-4 font-mono text-[11.5px] text-white/55"
    >
      <span class="text-white/80">最新版本：{PRODUCTS.kde.versionLabel}</span>
      <span class="h-3 w-px bg-white/20" aria-hidden="true"></span>
      <a href="/download/" class="transition-colors hover:text-white">下载</a>
      <span class="h-3 w-px bg-white/20" aria-hidden="true"></span>
      <a href="/docs/install-vmware/" class="transition-colors hover:text-white">系统要求</a>
      <span class="h-3 w-px bg-white/20" aria-hidden="true"></span>
      <a href="/products/kde/" class="transition-colors hover:text-white">版本说明</a>
      {latest?.published_at && (
        <>
          <span class="h-3 w-px bg-white/20" aria-hidden="true"></span>
          <span>GitHub Release {latest.tag_name} · {latest.published_at.slice(0, 10)}</span>
        </>
      )}
    </div>
  </div>
</section>
