---
import { TIMELINE, AUTHOR_NOTE } from "@/data/timeline";
---

<div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
  <div>
    <blockquote
      class="border-l-[3px] border-breeze-300 pl-5 text-[15px] leading-[1.9] text-ink-2"
    >
      {AUTHOR_NOTE}
    </blockquote>
    <p class="mt-4 pl-5 font-mono text-[11.5px] text-faint">
      —— 作者自述，摘自 KDE 版仓库 README
    </p>
  </div>

  <ol class="relative space-y-7 border-l border-line pl-6 sm:pl-8">
    {
      TIMELINE.map((item) => (
        <li class="relative">
          <span
            class="absolute -left-[calc(1.5rem+5px)] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-canvas bg-breeze-500 sm:-left-[calc(2rem+5px)]"
            aria-hidden="true"
          />
          <p class="font-mono text-[11.5px] uppercase tracking-[0.12em] text-breeze-700">
            {item.time}
          </p>
          <h3 class="mt-1.5 font-display text-[16.5px] font-semibold text-ink">
            {item.title}
          </h3>
          <p class="mt-1.5 max-w-[58ch] text-[14px] leading-relaxed text-muted">
            {item.detail}
          </p>
        </li>
      ))
    }
  </ol>
</div>
