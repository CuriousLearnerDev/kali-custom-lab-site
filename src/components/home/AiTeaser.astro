---
import { Picture } from "astro:assets";
import { AI_SCENARIOS } from "@/data/tools";
import { AI_SHOTS } from "@/data/home";
import WindowFrame from "@/components/media/WindowFrame.astro";

const main = AI_SHOTS.MAIN;
const secondary = AI_SHOTS.SECONDARY;
---

<div
  class="relative overflow-hidden rounded-card-lg border border-white/10 bg-[#0b1524] p-6 text-[#d7e3f2] sm:p-10"
>
  <!-- 深色面板上的光斑 -->
  <div
    class="pointer-events-none absolute -right-32 -top-40 h-[420px] w-[420px] rounded-full"
    style="background: radial-gradient(closest-side, rgba(139,92,246,.34), transparent 72%)"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-40 -left-24 h-[380px] w-[380px] rounded-full"
    style="background: radial-gradient(closest-side, rgba(44,155,230,.3), transparent 72%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative grid gap-10 lg:grid-cols-[1fr_1.05fr] lg:items-center">
    <div class="min-w-0">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-[#7fc4f5]">
        V4 · Gemini CLI
      </p>
      <h3 class="mt-3 font-display text-[clamp(24px,3vw,32px)] font-semibold leading-tight text-white">
        终端里说中文，<br />它替你拼命令
      </h3>
      <p class="mt-4 max-w-[44ch] text-[14.5px] leading-relaxed text-[#a8bcd4]">
        V4 集成了 2025 年 6 月谷歌发布的 Gemini CLI。下面这五个场景都是作者在
        README 里录的实际演示，输入的原话逐字保留。
      </p>

      <ul class="mt-6 space-y-3">
        {
          AI_SCENARIOS.map((scenario, i) => (
            <li class="flex gap-3">
              <span class="mt-0.5 font-mono text-[11px] text-[#5b7391]">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="min-w-0">
                <p class="text-[13.5px] font-medium text-[#e6eef8]">
                  {scenario.title}
                </p>
                <p class="mt-1 truncate font-mono text-[11.5px] text-[#7d93ac]">
                  {scenario.prompt}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="min-w-0 space-y-4">
      <a
        href={main.image.src}
        data-shot
        data-caption={main.caption}
        data-alt={main.alt}
        class="block"
        aria-label={`放大查看：${main.alt}`}
      >
        <WindowFrame title="gemini-cli — Konsole">
          <Picture
            fallbackFormat="webp"
            src={main.image}
            formats={["avif", "webp"]}
            widths={[640, 1000, 1600]}
            sizes="(max-width: 1024px) 92vw, 520px"
            alt={main.alt}
            loading="lazy"
            decoding="async"
            class="w-full"
          />
        </WindowFrame>
      </a>

      <a
        href={secondary.image.src}
        data-shot
        data-caption={secondary.caption}
        data-alt={secondary.alt}
        class="hidden w-[72%] sm:block"
        aria-label={`放大查看：${secondary.alt}`}
      >
        <WindowFrame title="gemini-cli — /etc/fstab">
          <Picture
            fallbackFormat="webp"
            src={secondary.image}
            formats={["webp"]}
            widths={[400, 800]}
            sizes="(max-width: 1024px) 60vw, 340px"
            alt={secondary.alt}
            loading="lazy"
            decoding="async"
            class="w-full"
          />
        </WindowFrame>
      </a>
    </div>
  </div>
</div>
