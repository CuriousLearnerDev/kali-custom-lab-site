---
import { Image } from "astro:assets";
import Badge from "@/components/ui/Badge.astro";
import { PRODUCT_LIST } from "@/data/products";
import { VERSIONS } from "@/data/versions";
import { shot } from "@/data/shots";
import { getRepo, stat } from "@/lib/github";

const imagery = {
  kde: shot("v5-ui-09"),
  i3: shot("i3wm-desktop"),
};

const versionOf = (key: string) => VERSIONS.find((v) => v.id === key);
---

<ul class="grid gap-6 lg:grid-cols-2">
  {
    PRODUCT_LIST.map((product) => {
      const img = imagery[product.key];
      const version = product.key === "kde" ? versionOf("v4") : versionOf("i3");
      const repo = getRepo(product.key);
      const archived = product.status === "archived";

      return (
        <li>
          <article
            class:list={[
              "glass-flat glass-hover flex h-full flex-col overflow-hidden",
              archived && "border-warn-line/70",
            ]}
          >
            <div class="relative aspect-[16/9] overflow-hidden bg-[#0b1524]">
              <Image
                src={img.image}
                alt={img.alt}
                widths={[560, 900]}
                sizes="(max-width: 1024px) 92vw, 560px"
                loading="lazy"
                class="h-full w-full object-cover object-top opacity-90"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-[#0b1524]/70 via-transparent to-transparent"
                aria-hidden="true"
              />
              <div class="absolute left-4 top-4">
                <Badge tone={archived ? "archived" : "active"}>
                  {archived ? "已归档 · 停止维护" : "持续维护"}
                </Badge>
              </div>
            </div>

            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-display text-[21px] font-semibold text-ink">
                  {product.name}
                </h3>
                <span class="font-mono text-[12px] text-faint">
                  {product.versionLabel}
                </span>
              </div>

              <p class="mt-2 text-[14px] leading-relaxed text-muted">
                {product.tagline}
              </p>

              <dl class="mt-4 space-y-1.5 border-t border-line pt-4 font-mono text-[12px]">
                <div class="flex justify-between gap-4">
                  <dt class="text-faint">基础系统</dt>
                  <dd class="text-ink-2">{product.baseSystem}</dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="text-faint">桌面环境</dt>
                  <dd class="text-ink-2">{product.desktop}</dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="text-faint">仓库</dt>
                  <dd class="text-ink-2">
                    {stat(repo.forks)} fork · {repo.open_issues} issues
                  </dd>
                </div>
                {version?.releaseDate && (
                  <div class="flex justify-between gap-4">
                    <dt class="text-faint">最近发布</dt>
                    <dd class="text-ink-2">{version.releaseDate}</dd>
                  </div>
                )}
              </dl>

              <div class="mt-5 flex items-center gap-4">
                <a
                  href={`/products/${product.key === "kde" ? "kde" : "i3wm"}/`}
                  class="inline-flex items-center gap-1.5 text-[14px] font-medium text-breeze-700 transition-colors hover:text-breeze-600"
                >
                  查看详情
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
                {archived ? (
                  <span class="font-mono text-[11.5px] text-warn-fg">
                    新用户建议选 KDE 版
                  </span>
                ) : (
                  <span class="font-mono text-[11.5px] text-faint">
                    需要自己写配置
                  </span>
                )}
              </div>
            </div>
          </article>
        </li>
      );
    })
  }
</ul>
