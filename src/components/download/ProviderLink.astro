---
import type { Channel } from "@/data/downloads";
import { PROVIDERS } from "@/data/downloads";
import CopyCode from "@/components/ui/CopyCode.astro";

interface Props {
  channel: Channel;
  compact?: boolean;
}

const { channel, compact = false } = Astro.props;
const provider = PROVIDERS[channel.provider];
---

<div
  class:list={[
    "flex flex-wrap items-center gap-x-4 gap-y-2",
    !compact && "rounded-control border border-line bg-surface/60 px-3.5 py-3",
  ]}
>
  <a
    href={channel.url}
    target="_blank"
    rel="noopener noreferrer"
    class="btn btn--primary btn--sm"
  >
    {provider.name}
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>

  {channel.code && <CopyCode value={channel.code} />}

  {
    channel.status !== "ok" && (
      <span class="font-mono text-[11.5px] text-warn-fg">链接待验证</span>
    )
  }
</div>
