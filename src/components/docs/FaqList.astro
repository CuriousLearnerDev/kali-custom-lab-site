---
import { FAQ, issueUrl, type Severity } from "@/data/faq";
import { PRODUCTS } from "@/data/products";

const groups: { key: Severity; label: string; note: string }[] = [
  { key: "blocker", label: "会挡住你的问题", note: "装完之后最先遇到、也最影响使用的" },
  { key: "common", label: "常见问题", note: "多数人会碰到的" },
  { key: "info", label: "其他", note: "偶尔会有人问的" },
];

const repo = PRODUCTS.kde.repo;
---

<div class="space-y-10">
  {
    groups.map((group) => {
      const items = FAQ.filter((f) => f.severity === group.key);
      if (!items.length) return null;
      return (
        <section>
          <h2 class="font-display text-[20px] font-semibold text-ink">{group.label}</h2>
          <p class="mt-1 text-[13px] text-muted">{group.note}</p>

          <ul class="mt-4 list-none space-y-3 pl-0">
            {items.map((entry) => (
              <li id={entry.id} class="glass-flat scroll-mt-24 p-5">
                <h3 class="font-display text-[15.5px] font-medium text-ink">
                  {entry.question}
                </h3>
                <p class="mt-2 text-[13.5px] leading-[1.85] text-muted">{entry.answer}</p>
                <p class="mt-2.5 flex flex-wrap gap-3 font-mono text-[11.5px]">
                  {entry.relatedIssues.map((num) => (
                    <a
                      href={issueUrl(repo, num)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-breeze-700 underline decoration-breeze-300 underline-offset-2 hover:text-breeze-600"
                    >
                      issue #{num}
                    </a>
                  ))}
                  {entry.detailHref && (
                    <a
                      href={entry.detailHref}
                      class="text-breeze-700 underline decoration-breeze-300 underline-offset-2 hover:text-breeze-600"
                    >
                      相关文档
                    </a>
                  )}
                </p>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</div>
