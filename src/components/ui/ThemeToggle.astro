---
/**
 * 三态主题切换：跟随系统 / 浅色 / 深色。
 * 初始值由 BaseLayout 里的内联脚本在首屏渲染前写入，避免闪白。
 */
---

<button
  type="button"
  data-theme-toggle
  class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-control border border-line bg-surface/70 text-ink-2 transition-colors hover:border-breeze-300 hover:text-breeze-700"
  aria-label="切换主题：跟随系统、浅色、深色"
  title="切换主题（跟随系统 / 浅色 / 深色）"
>
  <!-- 跟随系统 -->
  <svg class="theme-toggle__icon theme-toggle__icon--auto" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <rect x="2.5" y="4" width="19" height="13" rx="2.5"></rect>
    <path d="M8 20.5h8" stroke-linecap="round"></path>
  </svg>
  <!-- 浅色：太阳 -->
  <svg class="theme-toggle__icon theme-toggle__icon--light" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4" stroke-linecap="round"></path>
  </svg>
  <!-- 深色：月亮 -->
  <svg class="theme-toggle__icon theme-toggle__icon--dark" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path d="M20.5 14.2A8.6 8.6 0 0 1 9.8 3.5 8.6 8.6 0 1 0 20.5 14.2Z" stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = "theme-choice";
  const root = document.documentElement;
  const mq = window.matchMedia("(prefers-color-scheme: dark)");
  const ORDER = ["auto", "light", "dark"] as const;
  type Choice = (typeof ORDER)[number];

  const resolve = (choice: Choice) =>
    choice === "auto" ? (mq.matches ? "dark" : "light") : choice;

  const apply = (choice: Choice) => {
    const theme = resolve(choice);
    root.dataset.themeChoice = choice;
    root.dataset.theme = theme;
    const meta = document.querySelector<HTMLMetaElement>(
      'meta[name="theme-color"]',
    );
    if (meta) meta.content = theme === "dark" ? "#0a0f16" : "#f4f6fb";
  };

  document.addEventListener("click", (event) => {
    const btn = (event.target as HTMLElement | null)?.closest(
      "[data-theme-toggle]",
    );
    if (!btn) return;
    const current = (root.dataset.themeChoice as Choice) ?? "auto";
    const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length]!;
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      /* 隐私模式下写不了 localStorage，本次会话仍然生效 */
    }
    apply(next);
  });

  // 选「跟随系统」时，系统切换要实时响应
  mq.addEventListener("change", () => {
    if (((root.dataset.themeChoice as Choice) ?? "auto") === "auto") {
      apply("auto");
    }
  });
</script>
