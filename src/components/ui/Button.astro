---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  external?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  external = false,
  class: className = "",
  ariaLabel,
} = Astro.props;

const variants = {
  primary: "btn--primary",
  secondary: "btn--secondary",
  ghost: "btn--ghost",
} as const;

const sizes = {
  sm: "btn--sm",
  md: "btn--md",
  lg: "btn--lg",
} as const;

const base = "btn";

const cls = [base, variants[variant], sizes[size], className].join(" ");
const attrs = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

{
  href ? (
    <a href={href} class={cls} aria-label={ariaLabel} {...attrs}>
      <slot />
    </a>
  ) : (
    <button type="button" class={cls} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
