---
interface Props {
  /** true 时使用真毛玻璃（全站 ≤ 8 处，性能红线） */
  glass?: boolean;
  hover?: boolean;
  padding?: "none" | "sm" | "md" | "lg";
  as?: "div" | "article" | "section" | "li";
  class?: string;
}

const {
  glass = false,
  hover = false,
  padding = "md",
  as: Tag = "div",
  class: className = "",
} = Astro.props;

const paddings = {
  none: "",
  sm: "p-4",
  md: "p-5 sm:p-6",
  lg: "p-6 sm:p-8",
} as const;
---

<Tag
  class:list={[
    glass ? "glass" : "glass-flat",
    hover && "glass-hover",
    paddings[padding],
    className,
  ]}
>
  <slot />
</Tag>
