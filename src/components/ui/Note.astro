---
interface Props {
  variant?: "info" | "warn" | "danger" | "quote" | "ok";
  title?: string;
  class?: string;
}

const { variant = "info", title, class: className = "" } = Astro.props;

const variants = {
  info: "border-breeze-300/60 bg-breeze-50/80 text-ink-2",
  ok: "border-ok-fg/25 bg-ok-bg text-ink-2",
  warn: "border-warn-line bg-warn-bg text-ink-2",
  danger: "border-danger-fg/25 bg-danger-bg text-ink-2",
  quote: "border-line-strong bg-surface-tint text-muted",
} as const;

const iconTones = {
  info: "text-breeze-600",
  ok: "text-ok-fg",
  warn: "text-warn-fg",
  danger: "text-danger-fg",
  quote: "text-faint",
} as const;
---

<div
  class:list={[
    "rounded-card border-l-[3px] border-y border-r px-4 py-3.5 text-[14px] leading-relaxed sm:px-5",
    variants[variant],
    className,
  ]}
>
  {title && <p class:list={["mb-1 font-medium", iconTones[variant]]}>{title}</p>}
  <div class="space-y-2 [&_a]:underline [&_a]:decoration-current/30 [&_a]:underline-offset-2">
    <slot />
  </div>
</div>
