---
import BaseLayout from "./BaseLayout.astro";
import type { DocGroup } from "@/lib/docs";
import { docHref } from "@/lib/docs";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  category?: string;
  slug?: string;
  headings?: Heading[];
  groups: DocGroup[];
  prev?: { id: string; data: { title: string } };
  next?: { id: string; data: { title: string } };
  sources?: string[];
  relatedIssues?: number[];
}

const {
  title,
  description,
  slug,
  headings = [],
  groups,
  prev,
  next,
  sources = [],
  relatedIssues = [],
} = Astro.props;

const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={title} description={description}>
  <div class="shell py-10 sm:py-14">
    <nav class="font-mono text-[11.5px] text-faint" aria-label="面包屑">
      <a href="/" class="hover:text-breeze-700">首页</a>
      <span class="mx-1.5">/</span>
      <a href="/docs/" class="hover:text-breeze-700">文档</a>
      {slug && (
        <>
          <span class="mx-1.5">/</span>
          <span class="text-ink-2">{title}</span>
        </>
      )}
    </nav>

    <div class="mt-6 grid gap-10 lg:grid-cols-[200px_minmax(0,1fr)_180px]">
      <!-- 左侧：分类导航（移动端折叠） -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <details class="group glass-flat px-4 py-3 lg:hidden" open>
          <summary class="flex cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden">
            <span class="label-caps">文档目录</span>
            <svg
              class="text-faint transition-transform group-open:rotate-180"
              width="12" height="12" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.4" aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </summary>
          <nav class="mt-3 space-y-4" aria-label="文档目录">
            {
              groups.map((group) => (
                <div>
                  <p class="mb-1.5 font-mono text-[11px] text-faint">{group.category}</p>
                  <ul class="space-y-0.5">
                    {group.docs.map((doc) => (
                      <li>
                        <a
                          href={docHref(doc)}
                          class:list={[
                            "block rounded-[6px] px-2 py-1 text-[13px] transition-colors",
                            doc.id === slug
                              ? "bg-breeze-50 font-medium text-breeze-700"
                              : "text-ink-2 hover:bg-canvas-deep",
                          ]}
                          aria-current={doc.id === slug ? "page" : undefined}
                        >
                          {doc.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </nav>
        </details>

        <nav class="hidden lg:block" aria-label="文档目录">
          {
            groups.map((group) => (
              <div class="mb-5">
                <p class="mb-2 font-mono text-[10.5px] uppercase tracking-[0.14em] text-faint">
                  {group.category}
                </p>
                <ul class="space-y-0.5">
                  {group.docs.map((doc) => (
                    <li>
                      <a
                        href={docHref(doc)}
                        class:list={[
                          "block rounded-[6px] px-2 py-1.5 text-[13px] leading-snug transition-colors",
                          doc.id === slug
                            ? "bg-breeze-50 font-medium text-breeze-700"
                            : "text-ink-2 hover:bg-canvas-deep hover:text-ink",
                        ]}
                        aria-current={doc.id === slug ? "page" : undefined}
                      >
                        {doc.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>

      <!-- 正文 -->
      <article class="min-w-0">
        <header class="border-b border-line pb-6">
          <h1 class="text-[clamp(26px,3.2vw,34px)] font-display leading-tight text-ink">
            {title}
          </h1>
          <p class="lead mt-2.5 text-[15px]">{description}</p>
        </header>

        <div class="prose-cn mt-8">
          <slot />
        </div>

        {
          (sources.length > 0 || relatedIssues.length > 0) && (
            <div class="mt-10 rounded-card border border-line bg-surface-tint px-4 py-3.5">
              <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-faint">
                本文依据
              </p>
              <p class="mt-1.5 text-[12.5px] leading-relaxed text-muted">
                {sources.length > 0 && <span>仓库 README 章节：{sources.join(" · ")}</span>}
                {relatedIssues.length > 0 && (
                  <span>
                    {sources.length > 0 && "　"}
                    关联 issue：{relatedIssues.map((n) => `#${n}`).join("、")}
                  </span>
                )}
              </p>
            </div>
          )
        }

        <nav class="mt-8 flex flex-col gap-3 border-t border-line pt-6 sm:flex-row sm:justify-between" aria-label="上一篇 / 下一篇">
          {
            prev ? (
              <a href={docHref(prev as never)} class="group block rounded-card border border-line px-4 py-3 transition-colors hover:border-breeze-300">
                <span class="font-mono text-[11px] text-faint">上一篇</span>
                <span class="mt-0.5 block text-[13.5px] text-ink group-hover:text-breeze-700">
                  {prev.data.title}
                </span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a href={docHref(next as never)} class="group block rounded-card border border-line px-4 py-3 text-right transition-colors hover:border-breeze-300 sm:ml-auto">
                <span class="font-mono text-[11px] text-faint">下一篇</span>
                <span class="mt-0.5 block text-[13.5px] text-ink group-hover:text-breeze-700">
                  {next.data.title}
                </span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </article>

      <!-- 右侧 TOC -->
      <aside class="hidden lg:sticky lg:top-24 lg:block lg:self-start">
        {
          toc.length > 1 && (
            <nav aria-label="本页目录">
              <p class="mb-2 font-mono text-[10.5px] uppercase tracking-[0.14em] text-faint">
                本页目录
              </p>
              <ul class="space-y-1.5 border-l border-line">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="-ml-px block border-l border-transparent pl-3 text-[12.5px] leading-snug text-muted transition-colors hover:border-breeze-300 hover:text-breeze-700"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>
