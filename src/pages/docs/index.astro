---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Badge from "@/components/ui/Badge.astro";
import { getDocGroups, docHref } from "@/lib/docs";
import { FEATURED_FAQ } from "@/data/faq";

const groups = await getDocGroups();
const total = groups.reduce((sum, g) => sum + g.docs.length, 0);
---

<BaseLayout
  title="文档中心"
  description="Kali 魔改版的安装、使用与排错文档：选型、虚拟机导入、首次配置、快捷键、AI 终端与故障排查。"
  ogImage="/og/docs.png"
>
  <section class="relative overflow-hidden pb-10 pt-12 sm:pt-16">

    <div class="shell relative">
      <p class="label-caps">Documentation</p>
      <h1 class="mt-3 text-[clamp(30px,4vw,44px)] font-display leading-[1.15] text-ink">
        文档中心
      </h1>
      <p class="lead mt-3 max-w-[58ch]">
        {total} 篇文档，覆盖从选版本到排错的全流程。内容以仓库 README 和真实 issue 为依据，
        每条结论都标注了出处。
      </p>

      <!-- 搜索：JS 增强；无 JS 时下方目录直接可用 -->
      <div class="mt-8 max-w-xl" data-search>
        <label for="doc-search" class="sr-only">搜索文档</label>
        <div class="relative">
          <input
            id="doc-search"
            type="search"
            placeholder="搜索：黑屏、网盘、输入法、快捷键…"
            autocomplete="off"
            class="w-full rounded-control border border-line-strong bg-surface/80 px-4 py-3 pl-11 text-[14px] text-ink placeholder:text-faint focus:border-breeze-300 focus:outline-none"
          />
          <svg
            class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-faint"
            width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
          </svg>
        </div>
        <ul data-results class="mt-3 space-y-1.5" hidden></ul>
        <noscript>
          <p class="mt-2 text-[12.5px] text-muted">搜索需要 JavaScript，直接浏览下方目录即可。</p>
        </noscript>
      </div>
    </div>
  </section>

  <div class="shell pb-16">
    <div class="grid gap-6 md:grid-cols-2">
      {
        groups.map((group) => (
          <section class="glass-flat p-5 sm:p-6">
            <div class="flex items-center justify-between gap-3">
              <h2 class="font-display text-[16px] font-semibold text-ink">
                {group.category}
              </h2>
              <span class="font-mono text-[11px] text-faint">
                {String(group.docs.length).padStart(2, "0")}
              </span>
            </div>
            <ul class="mt-3 space-y-0.5">
              {group.docs.map((doc) => (
                <li>
                  <a
                    href={docHref(doc)}
                    class="group flex items-baseline justify-between gap-3 rounded-[6px] px-2 py-2 transition-colors hover:bg-canvas-deep"
                  >
                    <span class="text-[14px] text-ink group-hover:text-breeze-700">
                      {doc.data.title}
                    </span>
                    <span class="shrink-0 font-mono text-[11px] text-faint">
                      {doc.data.updated.toISOString().slice(0, 10)}
                    </span>
                  </a>
                  <p class="px-2 pb-1.5 text-[12.5px] leading-relaxed text-muted">
                    {doc.data.description}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <section class="mt-10">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="label-caps">最常被问到</p>
          <h2 class="mt-2 font-display text-[20px] font-semibold text-ink">
            这几个问题，几乎每个人都会问
          </h2>
        </div>
        <a href="/docs/faq/" class="shrink-0 text-[13px] text-breeze-700 underline decoration-breeze-300 underline-offset-2">
          全部问题
        </a>
      </div>

      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          FEATURED_FAQ.map((entry) => (
            <li>
              <a
                href={`/docs/faq/#${entry.id}`}
                class="glass-flat glass-hover block px-4 py-3.5 text-[13.5px] leading-relaxed text-ink"
              >
                {entry.question}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-10 flex flex-wrap items-center gap-2">
      <Badge tone="neutral">内容依据仓库 README 与 15 条真实 issue</Badge>
      <Badge tone="neutral">更新于 2026-11-16</Badge>
    </div>
  </div>

  <script>
    type Entry = {
      slug: string;
      href: string;
      title: string;
      description: string;
      category: string;
      body: string;
    };

    const root = document.querySelector<HTMLElement>("[data-search]");
    if (root) {
      const input = root.querySelector<HTMLInputElement>("#doc-search")!;
      const list = root.querySelector<HTMLUListElement>("[data-results]")!;
      let index: Entry[] | null = null;
      let loading: Promise<void> | null = null;

      const load = () => {
        if (index) return Promise.resolve();
        if (loading) return loading;
        loading = fetch("/search-index.json")
          .then((r) => r.json())
          .then((data: Entry[]) => {
            index = data;
          })
          .catch(() => {
            index = [];
          });
        return loading;
      };

      const score = (entry: Entry, q: string) => {
        if (entry.title.includes(q)) return 3;
        if (entry.description.includes(q)) return 2;
        if (entry.body.includes(q)) return 1;
        return 0;
      };

      const render = () => {
        const q = input.value.trim();
        if (!q || !index) {
          list.hidden = true;
          list.innerHTML = "";
          return;
        }
        const hits = index
          .map((entry) => ({ entry, s: score(entry, q) }))
          .filter((hit) => hit.s > 0)
          .sort((a, b) => b.s - a.s)
          .slice(0, 6);

        list.hidden = false;
        list.innerHTML = hits.length
          ? hits
              .map(
                ({ entry }) => `
                <li>
                  <a href="${entry.href}" class="block rounded-card border border-line bg-surface px-4 py-2.5 transition-colors hover:border-breeze-300">
                    <span class="block text-[13.5px] text-ink">${entry.title}</span>
                    <span class="mt-0.5 block font-mono text-[11px] text-faint">${entry.category}</span>
                  </a>
                </li>`,
              )
              .join("")
          : `<li class="px-1 py-2 text-[13px] text-muted">没有匹配「${q.replace(/</g, "&lt;")}」的文档</li>`;
      };

      input.addEventListener("focus", load);
      input.addEventListener("input", () => {
        load().then(render);
      });
      input.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          input.value = "";
          render();
          input.blur();
        }
      });
    }
  </script>
</BaseLayout>
